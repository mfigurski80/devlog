- var re = /<h1.*>(.*)<\/h1>/
- var md = markdown(fs.readFileSync('./posts/' + filename, 'utf8')).split('\n')
- var match = re.exec(md[0])
- var title = match ? match[1] : filename.split('-').join(' ')
- var dateString = getDate(filename).toDateString().split(' ').slice(1, 4).join(' ')

html(lang="en")
    head
        include head.pug
        title='DevLog | ' + title
    body
        .container
            include elements/header.pug

            article(id=title)
                h1.title='[' + dateString + '] ' + title
                != md.slice(1).join('\n')

            include elements/footer.pug
